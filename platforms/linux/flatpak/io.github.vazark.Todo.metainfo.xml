<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.vazark.Todo</id>
  <name>Todo</name>
  <summary>Organise tasks, subtasks and deadlines</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.vazark">
    <name>VaZark</name>
  </developer>
  <launchable type="desktop-id">io.github.vazark.Todo.desktop</launchable>
  <description>
    <p>Todo keeps your tasks in a kanban board or a list, with subtasks, epics, priorities, start and due dates, and tags.</p>
    <p>Nothing leaves your computer: your tasks live in a database in your own data directory.</p>
  </description>
  <provides>
    <binary>todo-gui</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.0.1" date="2026-11-10">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
